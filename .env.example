# Copy to .env.local (or .env) and fill in. Both are gitignored.
# Supabase dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key (sb_publishable_...). Safe in the browser: it is bound by
# Row Level Security. The older anon JWT works too, under either name.
# Never put the secret key here — NEXT_PUBLIC_ values ship to every visitor.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
